# Hasło do bazy: tylko litery i cyfry (znaki specjalne psują connection string).
# Wygeneruj np.: openssl rand -hex 24
POSTGRES_PASSWORD=

# Kod do założenia pierwszego konta. Ustaw losową wartość, np.: openssl rand -hex 8
# Po założeniu konta wyczyść go (zostaw puste) i wykonaj `docker compose up -d` — wtedy rejestracja bootstrap jest wyłączona.
BOOTSTRAP_CODE=
