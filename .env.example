# Hasło do bazy: tylko litery i cyfry (znaki specjalne psują connection string).
# Wygeneruj np.: openssl rand -hex 24
POSTGRES_PASSWORD=

# Konto administratora (jedyne, które tworzy kody zaproszeń). Tworzone przy starcie, jeśli nie istnieje;
# hasło istniejącego konta nie jest zmieniane. Hasło min. 8 znaków. Puste ADMIN_USERNAME = brak administratora.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Klucz Gemini API (Google AI Studio) do odczytu paragonów i regulaminów. Puste = AI wyłączone.
# To sekret — nie wklejaj go nigdzie poza plikiem .env (który nie trafia do repozytorium).
GEMINI_API_KEY=
